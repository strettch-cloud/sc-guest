#!/usr/bin/python3 -I
"""Sets the root password chosen when the VM was created, and tells the
platform whether the VM finished booting.

  sc-guest password   run once per boot by sc-guest-password.service, before
                      cloud-init's network stage
  sc-guest report     run once per boot by sc-guest-report.service, in the
                      background once the network is up

Only the Python standard library and this package's sc_guest module are
used, never cloud-init's code, so a cloud-init update can't break either
command. cloud-init's files are read as data: its status file and the current
instance ID.
"""

import http.client
import json
import os
import shutil
import subprocess
import sys
import tempfile
import threading
import time

from sc_guest import __version__, metadata

METADATA_HOST = "169.254.169.254"
# The metadata service gives up on its own lookups after 5 s, so waiting 6 s
# gets its answer instead of a timeout.
ATTEMPT_TIMEOUT = 6
MAX_RESPONSE_BYTES = 64 * 1024

STATE_DIR = "/var/lib/sc-guest"
PASSWORD_STATE = STATE_DIR + "/password.json"
RUN_DIR = "/run/sc-guest"
# This boot's password error, for this boot's report only.
PASSWORD_ERROR = RUN_DIR + "/password-error"

# sshd keeps the first value it reads, in filename order. cloud-init writes a
# customer's ssh_pwauth to 50-cloud-init.conf, so the customer wins, and this
# file wins over image defaults such as Ubuntu's 60-cloudimg-settings.conf.
SSHD_DROP_IN = "/etc/ssh/sshd_config.d/55-sc-guest-password.conf"
SSHD_DROP_IN_TEXT = (
    "# Written by sc-guest: this VM was created with a root password.\n"
    "PasswordAuthentication yes\n"
    "PermitRootLogin yes\n"
)

CLOUD_INIT_STATUS = "/run/cloud-init/status.json"
CLOUD_INIT_INSTANCE_ID = "/var/lib/cloud/data/instance-id"
# cloud-init's status file names the datasource it found by its class name,
# sometimes followed by details in brackets.
DATASOURCE = "DataSourceStrettchCloud"
BOOT_ID = "/proc/sys/kernel/random/boot_id"

# The platform's limits on a boot report.
MAX_REPORT_ERRORS = 20
MAX_ERROR_BYTES = 2048

os.environ["PATH"] = "/usr/sbin:/usr/bin:/sbin:/bin"


def log(message):
    print(message, flush=True)


class Refused(Exception):
    """The metadata service refused the request in a way retrying can't fix."""


def send(method, path, document=None):
    """Sends one request and returns (status, body)."""
    headers = dict(metadata.HEADERS)
    body = None
    if document is not None:
        body = json.dumps(document).encode()
        headers["Content-Type"] = "application/json"
    connection = http.client.HTTPConnection(METADATA_HOST, 80, timeout=ATTEMPT_TIMEOUT)
    try:
        connection.request(method, path, body=body, headers=headers)
        response = connection.getresponse()
        return response.status, response.read(MAX_RESPONSE_BYTES)
    finally:
        connection.close()


def error_code(body):
    try:
        return json.loads(body).get("code", "")
    except (ValueError, AttributeError):
        return ""


def until_answered(method, path, accept, max_delay, document=None):
    """Sends the request until the answer is a 2xx or a status in accept,
    and returns (status, body). Waits 1 s after the first failure, doubling
    up to max_delay. A 400 or 413 means the request itself is wrong, so it
    raises Refused instead of retrying."""
    delay = 1
    while True:
        try:
            status, body = send(method, path, document)
        except (OSError, http.client.HTTPException) as error:
            log(f"{method} {path}: {error}, retrying in {delay} s")
        else:
            if status in accept or 200 <= status < 300:
                return status, body
            if status in (400, 413):
                raise Refused(f"{method} {path}: refused with {status} {error_code(body)}")
            log(f"{method} {path}: {status} {error_code(body)}, retrying in {delay} s")
        time.sleep(delay)
        delay = min(delay * 2, max_delay)


def read_text(path):
    try:
        with open(path, encoding="utf-8") as f:
            return f.read().strip()
    except OSError:
        return ""


def read_json(path):
    try:
        with open(path, encoding="utf-8") as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def write_file(path, text, mode=0o644):
    """Replaces path atomically and makes the change durable."""
    directory = os.path.dirname(path)
    os.makedirs(directory, mode=0o755, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=directory, prefix=".sc-guest-")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(text)
            f.flush()
            os.fsync(f.fileno())
        os.chmod(tmp, mode)
        os.rename(tmp, path)
    except BaseException:
        os.unlink(tmp)
        raise
    dir_fd = os.open(directory, os.O_RDONLY)
    try:
        os.fsync(dir_fd)
    finally:
        os.close(dir_fd)


def current_instance_id():
    return read_text(CLOUD_INIT_INSTANCE_ID)


def password_state():
    """This instance's password state: None if it hasn't been handled yet,
    "set" while the ack is pending, "acked", or "none" when the VM was
    created without a password. State left by another instance, for example
    in a template made from this VM's disk, counts as None."""
    state = read_json(PASSWORD_STATE)
    if not isinstance(state, dict) or state.get("instance-id") != current_instance_id():
        return None
    return state.get("state")


def save_password_state(state):
    document = {"instance-id": current_instance_id(), "state": state}
    write_file(PASSWORD_STATE, json.dumps(document) + "\n")


# --- sc-guest password ---------------------------------------------------


def run(args, stdin=b""):
    return subprocess.run(args, input=stdin, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)


def output(result):
    return result.stdout.decode(errors="replace").strip()


def check_shadow(password):
    """Checks that root's entry in /etc/shadow matches the password, with
    perl's crypt(): chpasswd writes yescrypt, Python's crypt module is gone
    from Python 3.13, and perl-base is always installed."""
    root_hash = ""
    with open("/etc/shadow", encoding="utf-8") as f:
        for line in f:
            fields = line.split(":")
            if fields[0] == "root" and len(fields) > 1:
                root_hash = fields[1]
                break
    if not root_hash.startswith("$"):
        raise RuntimeError("root has no password hash in /etc/shadow after chpasswd")
    script = 'my ($h, $p) = <STDIN>; chomp($h, $p); my $c = crypt($p, $h); exit(defined $c && $c eq $h ? 0 : 1)'
    result = run(["perl", "-e", script], f"{root_hash}\n{password}\n".encode())
    if result.returncode != 0:
        raise RuntimeError("root's entry in /etc/shadow doesn't match the password after chpasswd")


def check_sshd():
    """Checks that sshd allows root to log in with a password. On first boot
    sshd has no host keys and no /run/sshd yet, and sshd -T exits without
    them, so it gets a throwaway key."""
    if not shutil.which("sshd") or not shutil.which("ssh-keygen"):
        raise RuntimeError("sshd or ssh-keygen isn't installed")
    os.makedirs("/run/sshd", mode=0o755, exist_ok=True)
    workdir = tempfile.mkdtemp(prefix="sc-guest-", dir="/run")
    try:
        key = os.path.join(workdir, "host-key")
        result = run(["ssh-keygen", "-q", "-t", "ed25519", "-N", "", "-f", key])
        if result.returncode != 0:
            raise RuntimeError(f"ssh-keygen failed: {output(result)}")
        result = run(["sshd", "-T", "-h", key])
        if result.returncode != 0:
            raise RuntimeError(f"sshd -T failed: {output(result)}")
    finally:
        shutil.rmtree(workdir, ignore_errors=True)
    settings = dict(line.split(" ", 1) for line in output(result).splitlines() if " " in line)
    for setting in ("passwordauthentication", "permitrootlogin"):
        if settings.get(setting) != "yes":
            raise RuntimeError(f"sshd -T shows {setting} {settings.get(setting, '(unset)')}, not yes")


def reload_sshd():
    if run(["systemctl", "is-active", "--quiet", "ssh.service"]).returncode == 0:
        result = run(["systemctl", "reload", "ssh.service"])
        if result.returncode != 0:
            raise RuntimeError(f"reloading sshd failed: {output(result)}")


def fetch_password():
    """Returns the pending password, or None when the VM was created
    without one. Retries exactly as the datasource does, then raises
    metadata.Unavailable: this unit runs before the rest of the boot, so it
    must not wait forever."""
    body = metadata.get("password")
    if body is None:
        log("no password is pending")
        return None
    try:
        password = json.loads(body)["password"]
    except (ValueError, KeyError, TypeError):
        raise RuntimeError("GET /v1/password answered 200 without a password") from None
    if not isinstance(password, str) or not password or any(c in password for c in "\n\r\0"):
        raise RuntimeError("GET /v1/password answered 200 with a password chpasswd can't take")
    return password


def set_password():
    status = read_json(CLOUD_INIT_STATUS)
    v1 = status.get("v1") if isinstance(status, dict) else None
    datasource = v1.get("datasource") if isinstance(v1, dict) else None
    if not isinstance(datasource, str) or not datasource.startswith(DATASOURCE):
        # Without our datasource, the network the metadata service needs may
        # be missing, and waiting for it would hold up the boot.
        log(f"cloud-init's datasource is {datasource or 'not found'}, not {DATASOURCE}: nothing to do")
        return
    if not current_instance_id():
        raise RuntimeError(f"cloud-init found {DATASOURCE} but wrote no {CLOUD_INIT_INSTANCE_ID}")
    state = password_state()
    if state is not None:
        log(f"the password was already handled for this instance ({state})")
        return

    password = fetch_password()
    if password is None:
        save_password_state("none")
        return

    result = run(["chpasswd"], f"root:{password}\n".encode())
    if result.returncode != 0:
        raise RuntimeError(f"chpasswd failed: {output(result)}")
    check_shadow(password)
    write_file(SSHD_DROP_IN, SSHD_DROP_IN_TEXT)
    check_sshd()
    reload_sshd()
    # The ack lets the platform delete the password, so the change must be on
    # disk before the state that leads to the ack.
    os.sync()
    save_password_state("set")
    log("set root's password and allowed password login over SSH")


def password_command():
    try:
        set_password()
    except Exception as error:
        message = f"password: {error}"
        log(message)
        write_file(PASSWORD_ERROR, message + "\n")
        return 1
    return 0


# --- sc-guest report -----------------------------------------------------


def bounded(message):
    """Fits one error into the platform's limits."""
    data = message.replace("\0", "").encode()
    if len(data) > MAX_ERROR_BYTES:
        data = data[: MAX_ERROR_BYTES - 3] + b"..."
    return data.decode(errors="ignore")


def boot_errors():
    """Errors from this boot's setup: the password, and cloud-init's local
    and network stages, which hold the datasource, network, hostname and SSH
    keys. Later stages run the customer's own scripts, so they're left out.
    So are failures of bootcmd, the one customer command run that early."""
    errors = []
    password_error = read_text(PASSWORD_ERROR)
    if password_error:
        errors.append(password_error)

    status = read_json(CLOUD_INIT_STATUS)
    v1 = status.get("v1") if isinstance(status, dict) else None
    if not isinstance(v1, dict):
        return errors + [f"cloud-init: {CLOUD_INIT_STATUS} is missing or unreadable"]
    stages = [v1.get("init-local") or {}, v1.get("init") or {}]
    for stage in stages:
        for error in stage.get("errors") or []:
            if not str(error).startswith("('bootcmd',"):
                errors.append(str(error))
    if not stages[1].get("finished"):
        errors.append("cloud-init: the network stage didn't finish")
    if not v1.get("datasource"):
        # cloud-init 25.1 and 26.x also keep its logged warnings and errors,
        # which say why the datasource didn't load. 22.4 only says that none
        # was found.
        for level in ("CRITICAL", "ERROR", "WARNING"):
            for stage in stages:
                errors.extend(str(e) for e in (stage.get("recoverable_errors") or {}).get(level) or [])
        if not errors:
            errors.append("cloud-init: no datasource found")

    unique = list(dict.fromkeys(bounded(e) for e in errors))
    if len(unique) > MAX_REPORT_ERRORS:
        dropped = len(unique) - MAX_REPORT_ERRORS + 1
        unique = unique[: MAX_REPORT_ERRORS - 1] + [f"and {dropped} more errors"]
    return unique


def send_report():
    errors = boot_errors()
    report = {
        "status": "error" if errors else "done",
        "boot-id": read_text(BOOT_ID),
        "errors": errors,
        "version": __version__,
    }
    until_answered("POST", "/v1/report/boot", accept=set(), max_delay=60, document=report)
    log(f"sent the boot report: {report['status']}")


def send_ack():
    """Acks a password set on this boot or an earlier one. A 404 means it was
    already consumed, so that counts as delivered too."""
    if password_state() != "set":
        return
    until_answered("POST", "/v1/password/ack", accept={404}, max_delay=60)
    save_password_state("acked")
    log("acked the password")


def report_command():
    failures = []

    def attempt(send):
        try:
            send()
        except Exception as error:
            log(str(error))
            failures.append(error)

    threads = [threading.Thread(target=attempt, args=(send,)) for send in (send_ack, send_report)]
    for thread in threads:
        thread.start()
    for thread in threads:
        thread.join()
    return 1 if failures else 0


def main():
    commands = {"password": password_command, "report": report_command}
    if len(sys.argv) != 2 or sys.argv[1] not in commands:
        print("usage: sc-guest password|report", file=sys.stderr)
        return 2
    return commands[sys.argv[1]]()


if __name__ == "__main__":
    sys.exit(main())
