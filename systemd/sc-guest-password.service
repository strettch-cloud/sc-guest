# Runs before cloud-init's network stage: cloud-init.service, or
# cloud-init-network.service on Debian 13. Ubuntu applies a customer's own
# password in that stage, so the customer's password wins.
[Unit]
Description=Set the root password chosen when the VM was created
Documentation=https://github.com/strettch-cloud/sc-guest
DefaultDependencies=no
After=cloud-init-local.service systemd-networkd-wait-online.service networking.service
Before=cloud-init.service cloud-init-network.service
Before=sysinit.target shutdown.target
Conflicts=shutdown.target
RequiresMountsFor=/var/lib/sc-guest

[Service]
Type=oneshot
ExecStart=/usr/lib/sc-guest/sc-guest password
RemainAfterExit=yes
# Waits for the metadata service as long as the datasource does.
TimeoutStartSec=infinity
StandardOutput=journal+console

[Install]
WantedBy=cloud-init.target
